# Copy this file to .env.local and fill in your Supabase values.
# In Supabase: open the ConcertCosts project → Settings → API (or Connect).
# Copy the Project URL and the publishable (anon) public key — never the service role key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Artist Finder (server only — get a free key at https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
